# Copy to .env (gitignored, chmod 600). NEVER commit real values, never paste them into chat.
# --- LLM providers (routed backend: Groq -> OpenRouter -> extractive) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_BACKEND=extractive            # extractive | routed | hf_local | openai_compat
# --- Postgres (Neon or any managed/local Postgres) ---
PG_ADMIN_DSN=                     # schema OWNER (migrations + role setup only; Neon's owner has BYPASSRLS)
# PG_DSN is written by `python -m scripts.neon_setup` (low-privilege app role, RLS enforced)
STATE_TIMEOUT_MS=15000            # raise the state-store step budget for a REMOTE DB; leave unset when the DB is co-located
PG_COMMAND_TIMEOUT=20
# --- optional ---
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_TOKEN=
