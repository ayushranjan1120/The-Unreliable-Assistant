# Copy to .env (gitignored, chmod 600), then SAVE. NEVER commit real values or paste them into chat. No inline comments on value lines.

# --- LLM providers (LLM_BACKEND=routed tries Groq, then OpenRouter, then the deterministic extractive answer) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=meta-llama/llama-3.1-8b-instruct
# extractive | routed | hf_local | openai_compat
LLM_BACKEND=extractive

# --- Postgres (Neon or any Postgres). PG_ADMIN_DSN = schema OWNER, used only by `python -m scripts.neon_setup`.
# --- PG_DSN (low-privilege app role, RLS enforced) is written by that script. Do not use the owner as PG_DSN (Neon's owner bypasses RLS).
PG_ADMIN_DSN=
# Raise only for a REMOTE database (ms); leave unset when the DB is co-located with the app.
STATE_TIMEOUT_MS=
PG_COMMAND_TIMEOUT=20

# --- optional ---
REDIS_URL=redis://127.0.0.1:6379/0
ADMIN_TOKEN=
